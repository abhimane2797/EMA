# API mode switch
#
# Leave this EMPTY (or delete the .env file) to run the SPA against the
# in-memory mock API (src/api/mockApi.ts) — no backend required.
#
# Set it to talk to the real NestJS service in ../master_backend instead.
# Every screen then goes through src/api/backendApi.ts.
#
# Development: the Vite dev server proxies /api/v1 -> http://localhost:3000
# (see vite.config.ts), so a relative value works and avoids CORS.
VITE_API_BASE_URL=

# Example — relative (uses the dev proxy):
# VITE_API_BASE_URL=/api/v1
#
# Example — absolute (required for production builds):
# VITE_API_BASE_URL=https://api.example.gov.in/api/v1
